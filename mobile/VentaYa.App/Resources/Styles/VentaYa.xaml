<?xml version="1.0" encoding="UTF-8" ?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
                    xmlns:app="clr-namespace:VentaYa.App">

    <Color x:Key="Peligro">#B3261E</Color>
    <Color x:Key="Exito">#2E7D5B</Color>
    <Color x:Key="Aviso">#B26A00</Color>
    <Color x:Key="Fondo">#F5F7FA</Color>

    <app:DineroConverter x:Key="Dinero" />
    <app:EstadoColorConverter x:Key="EstadoColor" />
    <app:FechaLocalConverter x:Key="FechaLocal" />
    <app:LimiteConverter x:Key="Limite" />
    <app:ImagenUrlConverter x:Key="ImagenUrl" />
    <app:NoNuloConverter x:Key="NoNulo" />
    <app:MayorACeroConverter x:Key="MayorACero" />

    <!-- Tarjeta blanca con borde suave -->
    <Style x:Key="Tarjeta" TargetType="Border">
        <Setter Property="BackgroundColor" Value="White" />
        <Setter Property="Stroke" Value="#DDE3EA" />
        <Setter Property="StrokeThickness" Value="1" />
        <Setter Property="StrokeShape" Value="RoundRectangle 14" />
        <Setter Property="Padding" Value="14" />
    </Style>

    <Style x:Key="Titulo" TargetType="Label">
        <Setter Property="FontSize" Value="24" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="TextColor" Value="{StaticResource Primary}" />
    </Style>

    <Style x:Key="Subtitulo" TargetType="Label">
        <Setter Property="FontSize" Value="14" />
        <Setter Property="TextColor" Value="#5C6B73" />
    </Style>

    <Style x:Key="Etiqueta" TargetType="Label">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="TextColor" Value="#5C6B73" />
        <Setter Property="Margin" Value="0,4,0,-6" />
    </Style>

    <Style x:Key="MensajeError" TargetType="Label">
        <Setter Property="TextColor" Value="{StaticResource Peligro}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="BackgroundColor" Value="#FDECEA" />
        <Setter Property="Padding" Value="10" />
    </Style>

    <Style x:Key="BotonSecundario" TargetType="Button">
        <Setter Property="BackgroundColor" Value="Transparent" />
        <Setter Property="TextColor" Value="{StaticResource Primary}" />
        <Setter Property="BorderColor" Value="{StaticResource Primary}" />
        <Setter Property="BorderWidth" Value="1" />
    </Style>

    <Style x:Key="BotonPeligro" TargetType="Button">
        <Setter Property="BackgroundColor" Value="Transparent" />
        <Setter Property="TextColor" Value="{StaticResource Peligro}" />
        <Setter Property="BorderColor" Value="{StaticResource Peligro}" />
        <Setter Property="BorderWidth" Value="1" />
    </Style>

    <Style x:Key="Chip" TargetType="Button">
        <Setter Property="BackgroundColor" Value="#E8EEF4" />
        <Setter Property="TextColor" Value="{StaticResource Primary}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="CornerRadius" Value="18" />
        <Setter Property="HeightRequest" Value="36" />
        <Setter Property="Padding" Value="14,0" />
    </Style>
</ResourceDictionary>
