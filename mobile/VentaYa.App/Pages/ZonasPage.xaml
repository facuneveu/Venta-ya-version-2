<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:VentaYa.App.Core.ViewModels;assembly=VentaYa.App.Core"
             xmlns:m="clr-namespace:VentaYa.App.Core.Models;assembly=VentaYa.App.Core"
             x:Class="VentaYa.App.Pages.ZonasPage"
             x:DataType="vm:ZonasViewModel"
             Title="Zonas de envío"
             BackgroundColor="{StaticResource Fondo}">
    <RefreshView IsRefreshing="{Binding EstaOcupado, Mode=OneWay}" Command="{Binding CargarCommand}">
        <ScrollView>
            <VerticalStackLayout Padding="18" Spacing="12">
                <Border Style="{StaticResource Tarjeta}">
                    <VerticalStackLayout Spacing="8">
                        <Label Text="Zona" FontAttributes="Bold" />
                        <Entry Text="{Binding Nombre}" Placeholder="Nombre (ej: Centro)" />
                        <Entry Text="{Binding Precio}" Keyboard="Numeric" Placeholder="Costo de envío" />
                        <HorizontalStackLayout Spacing="10">
                            <Switch IsToggled="{Binding Activa}" VerticalOptions="Center" />
                            <Label Text="Activa" VerticalOptions="Center" />
                        </HorizontalStackLayout>
                        <Label Text="{Binding Error}" IsVisible="{Binding HayError}" Style="{StaticResource MensajeError}" />
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                            <Button Text="Guardar zona" Command="{Binding GuardarCommand}" IsEnabled="{Binding NoEstaOcupado}" />
                            <Button Grid.Column="1" Text="Limpiar" Style="{StaticResource BotonSecundario}" Command="{Binding LimpiarCommand}" />
                        </Grid>
                    </VerticalStackLayout>
                </Border>

                <Label Text="Tus zonas" FontAttributes="Bold" FontSize="16" />
                <VerticalStackLayout BindableLayout.ItemsSource="{Binding Zonas}" Spacing="8">
                    <BindableLayout.EmptyView>
                        <Label Text="Todavía no cargaste zonas de envío." Style="{StaticResource Subtitulo}" />
                    </BindableLayout.EmptyView>
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="m:ZonaDto">
                            <Border Style="{StaticResource Tarjeta}" Padding="12">
                                <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                                    <VerticalStackLayout>
                                        <Label Text="{Binding Nombre}" FontAttributes="Bold" />
                                        <Label Text="{Binding Precio, Converter={StaticResource Dinero}}" Style="{StaticResource Subtitulo}" />
                                        <Label Text="Inactiva" TextColor="{StaticResource Aviso}" FontSize="12">
                                            <Label.Triggers>
                                                <DataTrigger TargetType="Label" Binding="{Binding Activa}" Value="True">
                                                    <Setter Property="IsVisible" Value="False" />
                                                </DataTrigger>
                                            </Label.Triggers>
                                        </Label>
                                    </VerticalStackLayout>
                                    <Button Grid.Column="1" Text="Editar" Style="{StaticResource BotonSecundario}" HeightRequest="40"
                                            Command="{Binding EditarCommand, Source={RelativeSource AncestorType={x:Type vm:ZonasViewModel}}}"
                                            CommandParameter="{Binding .}" />
                                    <Button Grid.Column="2" Text="Borrar" Style="{StaticResource BotonPeligro}" HeightRequest="40"
                                            Command="{Binding EliminarCommand, Source={RelativeSource AncestorType={x:Type vm:ZonasViewModel}}}"
                                            CommandParameter="{Binding .}" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>
            </VerticalStackLayout>
        </ScrollView>
    </RefreshView>
</ContentPage>
