<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:VentaYa.App.Core.ViewModels;assembly=VentaYa.App.Core"
             x:Class="VentaYa.App.Pages.LoginPage"
             x:DataType="vm:LoginViewModel"
             Shell.NavBarIsVisible="False"
             BackgroundColor="{StaticResource Fondo}">
    <ScrollView>
        <VerticalStackLayout Padding="24" Spacing="14" VerticalOptions="Center">
            <Label Text="VentaYa" Style="{StaticResource Titulo}" FontSize="38" HorizontalOptions="Center" />
            <Label Text="Tus pedidos, ordenados." Style="{StaticResource Subtitulo}" HorizontalOptions="Center" Margin="0,0,0,18" />

            <Label Text="Email" Style="{StaticResource Etiqueta}" />
            <Entry Text="{Binding Email}" Keyboard="Email" Placeholder="tu@email.com" AutomationId="login_email" />

            <Label Text="Contraseña" Style="{StaticResource Etiqueta}" />
            <Entry Text="{Binding Password}" IsPassword="True" Placeholder="Tu contraseña"
                   ReturnCommand="{Binding IngresarCommand}" AutomationId="login_password" />

            <Label Text="{Binding Error}" IsVisible="{Binding HayError}" Style="{StaticResource MensajeError}" />

            <Button Text="Ingresar" Command="{Binding IngresarCommand}" IsEnabled="{Binding NoEstaOcupado}"
                    Margin="0,6,0,0" AutomationId="login_ingresar" />
            <ActivityIndicator IsRunning="{Binding EstaOcupado}" IsVisible="{Binding EstaOcupado}" />

            <Button Text="Crear una cuenta" Style="{StaticResource BotonSecundario}" Command="{Binding IrARegistroCommand}" />

            <Label x:Name="LblServidor" Style="{StaticResource Subtitulo}" FontSize="11"
                   HorizontalOptions="Center" Margin="0,24,0,0">
                <Label.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnCambiarServidor" />
                </Label.GestureRecognizers>
            </Label>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
