<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:VentaYa.App.Core.ViewModels;assembly=VentaYa.App.Core"
             xmlns:m="clr-namespace:VentaYa.App.Core.Models;assembly=VentaYa.App.Core"
             x:Class="VentaYa.App.Pages.PedidosPage"
             x:DataType="vm:PedidosViewModel"
             Title="Pedidos"
             BackgroundColor="{StaticResource Fondo}">
    <Grid RowDefinitions="Auto,Auto,*" Padding="14,10,14,0" RowSpacing="10">
        <ScrollView Grid.Row="0" Orientation="Horizontal" HorizontalScrollBarVisibility="Never">
            <HorizontalStackLayout x:Name="Filtros" Spacing="8" />
        </ScrollView>

        <Button Grid.Row="1" Text="+ Nuevo pedido" Command="{Binding NuevoPedidoCommand}" />

        <RefreshView Grid.Row="2" IsRefreshing="{Binding EstaOcupado, Mode=OneWay}" Command="{Binding CargarCommand}">
            <CollectionView ItemsSource="{Binding Pedidos}" SelectionMode="None">
                <CollectionView.EmptyView>
                    <Label Text="No hay pedidos para mostrar." Style="{StaticResource Subtitulo}"
                           HorizontalOptions="Center" Margin="0,40" />
                </CollectionView.EmptyView>
                <CollectionView.ItemsLayout>
                    <LinearItemsLayout Orientation="Vertical" ItemSpacing="8" />
                </CollectionView.ItemsLayout>
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="m:PedidoDto">
                        <Border Style="{StaticResource Tarjeta}">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer
                                    Command="{Binding AbrirCommand, Source={RelativeSource AncestorType={x:Type vm:PedidosViewModel}}}"
                                    CommandParameter="{Binding .}" />
                            </Border.GestureRecognizers>
                            <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto" RowSpacing="2">
                                <Label Grid.Column="0" Text="{Binding Id, StringFormat='Pedido #{0}'}" FontAttributes="Bold" />
                                <Label Grid.Column="1" Text="{Binding Total, Converter={StaticResource Dinero}}" FontAttributes="Bold" />
                                <Label Grid.Row="1" Grid.ColumnSpan="2" Text="{Binding ClienteNombre}" />
                                <Label Grid.Row="2" Grid.Column="0" Text="{Binding Estado}"
                                       TextColor="{Binding Estado, Converter={StaticResource EstadoColor}}" FontAttributes="Bold" FontSize="13" />
                                <Label Grid.Row="2" Grid.Column="1" Text="{Binding CreadoEn, Converter={StaticResource FechaLocal}}"
                                       Style="{StaticResource Subtitulo}" FontSize="12" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </RefreshView>
    </Grid>
</ContentPage>
