<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:VentaYa.App.Core.ViewModels;assembly=VentaYa.App.Core"
             xmlns:m="clr-namespace:VentaYa.App.Core.Models;assembly=VentaYa.App.Core"
             x:Class="VentaYa.App.Pages.EquipoPage"
             x:DataType="vm:EquipoViewModel"
             Title="Equipo"
             BackgroundColor="{StaticResource Fondo}">
    <RefreshView IsRefreshing="{Binding EstaOcupado, Mode=OneWay}" Command="{Binding CargarCommand}">
        <ScrollView>
            <VerticalStackLayout Padding="18" Spacing="12">
                <Border Style="{StaticResource Tarjeta}">
                    <VerticalStackLayout Spacing="8">
                        <Label Text="Invitar a un empleado" FontAttributes="Bold" />
                        <Label Text="Se genera un código que le pasás por WhatsApp. Tu empleado se registra en la app y lo pega al entrar."
                               Style="{StaticResource Subtitulo}" FontSize="12" />
                        <Entry Text="{Binding EmailInvitado}" Keyboard="Email" Placeholder="Email del empleado" />
                        <Label Text="{Binding Error}" IsVisible="{Binding HayError}" Style="{StaticResource MensajeError}" />
                        <Button Text="Generar invitación" Command="{Binding InvitarCommand}" IsEnabled="{Binding NoEstaOcupado}" />
                    </VerticalStackLayout>
                </Border>

                <Border Style="{StaticResource Tarjeta}" BackgroundColor="#E8F4EE"
                        IsVisible="{Binding CodigoGenerado, Converter={StaticResource NoNulo}}">
                    <VerticalStackLayout Spacing="6">
                        <Label Text="Código de invitación" FontAttributes="Bold" />
                        <Label Text="{Binding CodigoGenerado}" FontSize="15" FontFamily="OpenSansSemibold" />
                        <Button Text="Compartir código" Style="{StaticResource BotonSecundario}" Clicked="OnCompartirCodigo" />
                    </VerticalStackLayout>
                </Border>

                <Label Text="Miembros" FontAttributes="Bold" FontSize="16" />
                <VerticalStackLayout BindableLayout.ItemsSource="{Binding Miembros}" Spacing="8">
                    <BindableLayout.EmptyView>
                        <Label Text="Todavía no invitaste a nadie." Style="{StaticResource Subtitulo}" />
                    </BindableLayout.EmptyView>
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="m:MiembroDto">
                            <Border Style="{StaticResource Tarjeta}" Padding="12">
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                    <VerticalStackLayout>
                                        <Label Text="{Binding Nombre}" FontAttributes="Bold"
                                               IsVisible="{Binding Nombre, Converter={StaticResource NoNulo}}" />
                                        <Label Text="{Binding Email}" Style="{StaticResource Subtitulo}" />
                                        <Label Text="Invitación pendiente" TextColor="{StaticResource Aviso}" FontSize="12">
                                            <Label.Triggers>
                                                <DataTrigger TargetType="Label" Binding="{Binding Aceptado}" Value="True">
                                                    <Setter Property="IsVisible" Value="False" />
                                                </DataTrigger>
                                            </Label.Triggers>
                                        </Label>
                                    </VerticalStackLayout>
                                    <Button Grid.Column="1" Text="Quitar" Style="{StaticResource BotonPeligro}" HeightRequest="40"
                                            Command="{Binding RevocarCommand, Source={RelativeSource AncestorType={x:Type vm:EquipoViewModel}}}"
                                            CommandParameter="{Binding .}" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>
            </VerticalStackLayout>
        </ScrollView>
    </RefreshView>
</ContentPage>
