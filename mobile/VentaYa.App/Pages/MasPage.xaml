<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:VentaYa.App.Core.ViewModels;assembly=VentaYa.App.Core"
             x:Class="VentaYa.App.Pages.MasPage"
             x:DataType="vm:MasViewModel"
             Title="Más"
             BackgroundColor="{StaticResource Fondo}">
    <ScrollView>
        <VerticalStackLayout Padding="18" Spacing="10">
            <Label Text="{Binding NombreNegocio}" Style="{StaticResource Titulo}" />
            <Label Text="{Binding Usuario}" Style="{StaticResource Subtitulo}" Margin="0,0,0,10" />

            <Label Text="Ventas" Style="{StaticResource Etiqueta}" />
            <Button Text="🎟  Cupones de descuento" Style="{StaticResource BotonSecundario}" HorizontalOptions="Fill"
                    Command="{Binding AbrirCommand}" CommandParameter="cupones" />
            <Button Text="🛵  Zonas de envío" Style="{StaticResource BotonSecundario}"
                    Command="{Binding AbrirCommand}" CommandParameter="zonas" />
            <Button Text="💬  Respuestas rápidas" Style="{StaticResource BotonSecundario}"
                    Command="{Binding AbrirCommand}" CommandParameter="respuestas" />

            <VerticalStackLayout IsVisible="{Binding EsPropietario}" Spacing="10">
                <Label Text="Administración (solo propietario)" Style="{StaticResource Etiqueta}" Margin="0,10,0,0" />
                <Button Text="👥  Equipo" Style="{StaticResource BotonSecundario}"
                        Command="{Binding AbrirCommand}" CommandParameter="equipo" />
                <Button Text="🏪  Perfil del negocio" Style="{StaticResource BotonSecundario}"
                        Command="{Binding AbrirCommand}" CommandParameter="perfil" />
                <Button Text="⭐  Plan y límites" Style="{StaticResource BotonSecundario}"
                        Command="{Binding AbrirCommand}" CommandParameter="plan" />
            </VerticalStackLayout>

            <Button Text="Cerrar sesión" Style="{StaticResource BotonPeligro}" Margin="0,24,0,0"
                    Command="{Binding CerrarSesionCommand}" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
