<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:VentaYa.App.Core.ViewModels;assembly=VentaYa.App.Core"
             x:Class="VentaYa.App.Pages.OnboardingPage"
             x:DataType="vm:OnboardingViewModel"
             Shell.NavBarIsVisible="False"
             BackgroundColor="{StaticResource Fondo}">
    <ScrollView>
        <VerticalStackLayout Padding="24" Spacing="14">
            <Label Text="Armá tu negocio" Style="{StaticResource Titulo}" Margin="0,16,0,0" />
            <Label Text="Con esto ya podés empezar a cargar productos y pedidos." Style="{StaticResource Subtitulo}" />

            <Label Text="Nombre del negocio" Style="{StaticResource Etiqueta}" />
            <Entry Text="{Binding Nombre}" Placeholder="Ej: Kiosco Don Pepe" />

            <Label Text="Teléfono / WhatsApp" Style="{StaticResource Etiqueta}" />
            <Entry Text="{Binding Telefono}" Keyboard="Telephone" Placeholder="2954 123456" />

            <Label Text="Dirección (opcional)" Style="{StaticResource Etiqueta}" />
            <Entry Text="{Binding Direccion}" Placeholder="Calle y número" />

            <Label Text="Descripción (opcional)" Style="{StaticResource Etiqueta}" />
            <Editor Text="{Binding Descripcion}" HeightRequest="80" AutoSize="TextChanges" />

            <HorizontalStackLayout Spacing="10">
                <Switch IsToggled="{Binding EnvioHabilitado}" VerticalOptions="Center" />
                <Label Text="Hago envíos a domicilio" VerticalOptions="Center" />
            </HorizontalStackLayout>

            <Label Text="{Binding Error}" IsVisible="{Binding HayError}" Style="{StaticResource MensajeError}" />

            <Button Text="Crear mi negocio" Command="{Binding CrearNegocioCommand}" IsEnabled="{Binding NoEstaOcupado}" />
            <ActivityIndicator IsRunning="{Binding EstaOcupado}" IsVisible="{Binding EstaOcupado}" />

            <BoxView HeightRequest="1" Color="#DDE3EA" Margin="0,10" />

            <Label Text="¿Sos empleado de un negocio?" FontAttributes="Bold" />
            <Label Text="Pegá el código que te pasó el dueño y entrás a su negocio." Style="{StaticResource Subtitulo}" />
            <Entry Text="{Binding CodigoInvitacion}" Placeholder="Código de invitación" />
            <Button Text="Entrar con un código" Style="{StaticResource BotonSecundario}"
                    Command="{Binding AceptarInvitacionCommand}" IsEnabled="{Binding NoEstaOcupado}" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
