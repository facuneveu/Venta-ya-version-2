<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:VentaYa.App.Core.ViewModels;assembly=VentaYa.App.Core"
             xmlns:m="clr-namespace:VentaYa.App.Core.Models;assembly=VentaYa.App.Core"
             x:Class="VentaYa.App.Pages.RespuestasPage"
             x:DataType="vm:RespuestasViewModel"
             Title="Respuestas rápidas"
             BackgroundColor="{StaticResource Fondo}">
    <RefreshView IsRefreshing="{Binding EstaOcupado, Mode=OneWay}" Command="{Binding CargarCommand}">
        <ScrollView>
            <VerticalStackLayout Padding="18" Spacing="12">
                <Border Style="{StaticResource Tarjeta}">
                    <VerticalStackLayout Spacing="8">
                        <Label Text="Mensaje" FontAttributes="Bold" />
                        <Entry Text="{Binding Titulo}" Placeholder="Título (ej: Horarios)" />
                        <Editor Text="{Binding Contenido}" Placeholder="Hola {nombre}, tu pedido de {total} está en camino..." HeightRequest="100" AutoSize="TextChanges" />
                        <Label x:Name="LblAyuda" Style="{StaticResource Subtitulo}" FontSize="12" />
                        <Label Text="{Binding Error}" IsVisible="{Binding HayError}" Style="{StaticResource MensajeError}" />
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                            <Button Text="Guardar mensaje" Command="{Binding GuardarCommand}" IsEnabled="{Binding NoEstaOcupado}" />
                            <Button Grid.Column="1" Text="Limpiar" Style="{StaticResource BotonSecundario}" Command="{Binding LimpiarCommand}" />
                        </Grid>
                    </VerticalStackLayout>
                </Border>

                <Label Text="Tus mensajes" FontAttributes="Bold" FontSize="16" />
                <VerticalStackLayout BindableLayout.ItemsSource="{Binding Respuestas}" Spacing="8">
                    <BindableLayout.EmptyView>
                        <Label Text="Todavía no creaste respuestas rápidas." Style="{StaticResource Subtitulo}" />
                    </BindableLayout.EmptyView>
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="m:RespuestaDto">
                            <Border Style="{StaticResource Tarjeta}" Padding="12">
                                <VerticalStackLayout Spacing="6">
                                    <Label Text="{Binding Titulo}" FontAttributes="Bold" />
                                    <Label Text="{Binding Contenido}" Style="{StaticResource Subtitulo}" />
                                    <Grid ColumnDefinitions="*,*,*" ColumnSpacing="6">
                                        <Button Text="Compartir" Style="{StaticResource BotonSecundario}" HeightRequest="40" Clicked="OnCompartir" />
                                        <Button Grid.Column="1" Text="Editar" Style="{StaticResource BotonSecundario}" HeightRequest="40"
                                                Command="{Binding EditarCommand, Source={RelativeSource AncestorType={x:Type vm:RespuestasViewModel}}}"
                                                CommandParameter="{Binding .}" />
                                        <Button Grid.Column="2" Text="Borrar" Style="{StaticResource BotonPeligro}" HeightRequest="40"
                                                Command="{Binding EliminarCommand, Source={RelativeSource AncestorType={x:Type vm:RespuestasViewModel}}}"
                                                CommandParameter="{Binding .}" />
                                    </Grid>
                                </VerticalStackLayout>
                            </Border>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>
            </VerticalStackLayout>
        </ScrollView>
    </RefreshView>
</ContentPage>
