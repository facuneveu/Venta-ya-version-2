<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:VentaYa.App.Core.ViewModels;assembly=VentaYa.App.Core"
             xmlns:m="clr-namespace:VentaYa.App.Core.Models;assembly=VentaYa.App.Core"
             x:Class="VentaYa.App.Pages.CatalogoPage"
             x:DataType="vm:CatalogoViewModel"
             Title="Catálogo"
             BackgroundColor="{StaticResource Fondo}">
    <Grid RowDefinitions="Auto,Auto,Auto,*" Padding="14,10,14,0" RowSpacing="10">
        <SearchBar Grid.Row="0" Text="{Binding Busqueda}" Placeholder="Buscar producto" SearchCommand="{Binding CargarCommand}" />
        <Button Grid.Row="1" Text="+ Nuevo producto" Command="{Binding NuevoCommand}" />
        <Label Grid.Row="2" Text="{Binding Error}" IsVisible="{Binding HayError}" Style="{StaticResource MensajeError}" />

        <RefreshView Grid.Row="3" IsRefreshing="{Binding EstaOcupado, Mode=OneWay}" Command="{Binding CargarCommand}">
            <CollectionView ItemsSource="{Binding Productos}" SelectionMode="None">
                <CollectionView.EmptyView>
                    <Label Text="No hay productos. Tocá «+ Nuevo producto» para cargar el primero." Style="{StaticResource Subtitulo}"
                           HorizontalOptions="Center" HorizontalTextAlignment="Center" Margin="20,40" />
                </CollectionView.EmptyView>
                <CollectionView.ItemsLayout>
                    <LinearItemsLayout Orientation="Vertical" ItemSpacing="8" />
                </CollectionView.ItemsLayout>
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="m:ProductoDto">
                        <Border Style="{StaticResource Tarjeta}" Padding="10">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer
                                    Command="{Binding EditarCommand, Source={RelativeSource AncestorType={x:Type vm:CatalogoViewModel}}}"
                                    CommandParameter="{Binding .}" />
                            </Border.GestureRecognizers>
                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                                <Border Grid.Column="0" WidthRequest="56" HeightRequest="56" StrokeShape="RoundRectangle 10"
                                        BackgroundColor="#E8EEF4" StrokeThickness="0" Padding="0">
                                    <Label Text="🛍" FontSize="24" HorizontalOptions="Center" VerticalOptions="Center" />
                                </Border>
                                <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="2">
                                    <Label Text="{Binding Nombre}" FontAttributes="Bold" />
                                    <Label Text="{Binding Stock, Converter={StaticResource Limite}, StringFormat='Stock: {0}'}"
                                           Style="{StaticResource Subtitulo}" FontSize="12" />
                                    <Label Text="Inactivo (no se muestra a clientes)" TextColor="{StaticResource Aviso}" FontSize="11">
                                        <Label.Triggers>
                                            <DataTrigger TargetType="Label" Binding="{Binding Activo}" Value="True">
                                                <Setter Property="IsVisible" Value="False" />
                                            </DataTrigger>
                                        </Label.Triggers>
                                    </Label>
                                </VerticalStackLayout>
                                <Label Grid.Column="2" Text="{Binding Precio, Converter={StaticResource Dinero}}"
                                       FontAttributes="Bold" VerticalOptions="Center" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </RefreshView>
    </Grid>
</ContentPage>
