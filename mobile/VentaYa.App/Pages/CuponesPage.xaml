<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:VentaYa.App.Core.ViewModels;assembly=VentaYa.App.Core"
             xmlns:m="clr-namespace:VentaYa.App.Core.Models;assembly=VentaYa.App.Core"
             x:Class="VentaYa.App.Pages.CuponesPage"
             x:DataType="vm:CuponesViewModel"
             Title="Cupones"
             BackgroundColor="{StaticResource Fondo}">
    <RefreshView IsRefreshing="{Binding EstaOcupado, Mode=OneWay}" Command="{Binding CargarCommand}">
        <ScrollView>
            <VerticalStackLayout Padding="18" Spacing="12">
                <Border Style="{StaticResource Tarjeta}">
                    <VerticalStackLayout Spacing="8">
                        <Label Text="Cupón" FontAttributes="Bold" />
                        <Entry Text="{Binding Codigo}" Placeholder="Código (ej: PROMO10)" />
                        <Picker ItemsSource="{x:Static vm:CuponesViewModel.Tipos}" SelectedItem="{Binding Tipo}" Title="Tipo de descuento" />
                        <Entry Text="{Binding Valor}" Keyboard="Numeric" Placeholder="Valor (% o $)" />
                        <Entry Text="{Binding MontoMinimo}" Keyboard="Numeric" Placeholder="Pedido mínimo (opcional)" />
                        <Entry Text="{Binding UsosMaximos}" Keyboard="Numeric" Placeholder="Usos máximos (opcional)" />
                        <HorizontalStackLayout Spacing="10">
                            <Switch IsToggled="{Binding Activo}" VerticalOptions="Center" />
                            <Label Text="Activo" VerticalOptions="Center" />
                        </HorizontalStackLayout>
                        <Label Text="{Binding Error}" IsVisible="{Binding HayError}" Style="{StaticResource MensajeError}" />
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                            <Button Text="Guardar cupón" Command="{Binding GuardarCommand}" IsEnabled="{Binding NoEstaOcupado}" />
                            <Button Grid.Column="1" Text="Limpiar" Style="{StaticResource BotonSecundario}" Command="{Binding LimpiarCommand}" />
                        </Grid>
                    </VerticalStackLayout>
                </Border>

                <Label Text="Tus cupones" FontAttributes="Bold" FontSize="16" />
                <VerticalStackLayout BindableLayout.ItemsSource="{Binding Cupones}" Spacing="8">
                    <BindableLayout.EmptyView>
                        <Label Text="Todavía no creaste cupones." Style="{StaticResource Subtitulo}" />
                    </BindableLayout.EmptyView>
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="m:CuponDto">
                            <Border Style="{StaticResource Tarjeta}" Padding="12">
                                <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                                    <VerticalStackLayout>
                                        <Label Text="{Binding Codigo}" FontAttributes="Bold" />
                                        <Label Text="{Binding Tipo}" Style="{StaticResource Subtitulo}" FontSize="12" />
                                        <Label Text="{Binding Valor, StringFormat='Valor: {0:0.##}'}" Style="{StaticResource Subtitulo}" FontSize="12" />
                                        <Label Text="{Binding Usos, StringFormat='Usos: {0}'}" Style="{StaticResource Subtitulo}" FontSize="12" />
                                        <Label Text="Inactivo" TextColor="{StaticResource Aviso}" FontSize="12">
                                            <Label.Triggers>
                                                <DataTrigger TargetType="Label" Binding="{Binding Activo}" Value="True">
                                                    <Setter Property="IsVisible" Value="False" />
                                                </DataTrigger>
                                            </Label.Triggers>
                                        </Label>
                                    </VerticalStackLayout>
                                    <Button Grid.Column="1" Text="Editar" Style="{StaticResource BotonSecundario}" HeightRequest="40"
                                            Command="{Binding EditarCommand, Source={RelativeSource AncestorType={x:Type vm:CuponesViewModel}}}"
                                            CommandParameter="{Binding .}" />
                                    <Button Grid.Column="2" Text="Borrar" Style="{StaticResource BotonPeligro}" HeightRequest="40"
                                            Command="{Binding EliminarCommand, Source={RelativeSource AncestorType={x:Type vm:CuponesViewModel}}}"
                                            CommandParameter="{Binding .}" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>
            </VerticalStackLayout>
        </ScrollView>
    </RefreshView>
</ContentPage>
